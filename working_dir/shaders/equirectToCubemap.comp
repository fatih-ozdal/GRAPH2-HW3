#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define T_EQUIRECT layout(binding = 0)
#define I_CUBE     layout(rgba32f, binding = 1)

uniform T_EQUIRECT sampler2D uEquirect;
// imageCube (not image2DArray) to match the GL_TEXTURE_CUBE_MAP target; Mesa
// enforces this. Bound on image unit 1 so it never collides with a unit-0 2D.
I_CUBE writeonly uniform imageCube uCube;

layout(location = 1) uniform int uFaceSize;
const float PI = 3.14159265358979;

// Standard GL cube face direction from an in-face uv in [-1, 1].
vec3 FaceDirection(uint face, vec2 uv)
{
    if(face == 0u) return vec3(  1.0, -uv.y, -uv.x); // +X
    if(face == 1u) return vec3( -1.0, -uv.y,  uv.x); // -X
    if(face == 2u) return vec3( uv.x,   1.0,  uv.y); // +Y
    if(face == 3u) return vec3( uv.x,  -1.0, -uv.y); // -Y
    if(face == 4u) return vec3( uv.x, -uv.y,   1.0); // +Z
    return                vec3(-uv.x, -uv.y,  -1.0); // -Z
}

void main()
{
    ivec2 size  = ivec2(uFaceSize);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    uint  face  = gl_GlobalInvocationID.z;
    if(texel.x >= size.x || texel.y >= size.y) return;

    // Pixel center -> [-1, 1]
    vec2 uv = (vec2(texel) + 0.5) / vec2(size) * 2.0 - 1.0;

    // The standard GL face-direction table already matches how the cubemap is
    // sampled, so the produced direction is used as-is (no per-face flips).
    vec3 dir = normalize(FaceDirection(face, uv));

    // Direction -> equirectangular UV, identical to the HW2 shaders'
    // DirToSphericalUV so the baked cube keeps the source orientation.
    float azimuth = atan(dir.x, dir.z);
    float incl    = acos(clamp(dir.y, -1.0, 1.0));
    vec2 e = vec2((azimuth + PI) * (0.5 / PI), 1.0 - incl / PI);

    vec3 color = textureLod(uEquirect, e, 0.0).rgb;
    imageStore(uCube, ivec3(texel, int(face)), vec4(color, 1.0));
}
